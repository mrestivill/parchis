{
  "name": "parchis-game-monorepo",
  "version": "0.9.35",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=@parchis/shared && npm run build --workspace=@parchis/server && npm run build --workspace=@parchis/client",
    "start": "npm start --workspace=server"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.3.3"
  }
}
