# ==========================================
# Client Configuration (.env)
# ==========================================

# The URL where the Parchis server (Backend) is running.
# The client uses this address to establish Socket.io connections 
# and make API requests.
#
# Examples based on your setup:
#
# 1. Local Development (Browser and server on the same PC):
# VITE_SERVER_URL=http://localhost:3000
#
# 2. Local Network Testing (Testing from your phone on the same WiFi):
# VITE_SERVER_URL=http://192.168.1.X:3000
#
# 3. Production Deployment (Accessible from the internet):
# VITE_SERVER_URL=https://parchis.yourdomain.com
#
VITE_SERVER_URL=http://localhost:3000
