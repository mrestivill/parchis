# ==========================================
# Server Configuration (.env)
# ==========================================

# Port where the Node.js server will run
# Development: Usually 3000
# Production: Can be 3000 or any other port proxied by Nginx/Caddy
PORT=3000

# Server Mode
# Options:
# - "development": Shows detailed error messages and logs (Use when coding)
# - "production": Optimized for speed and security (Use when deploying to the internet)
NODE_ENV=production

# ==========================================
# Security
# ==========================================

# Authentication Secret (JSON Web Token)
# This is a critical cryptographic key used to sign player login sessions.
# It MUST be long, random, and kept completely secret.
# 
# 👉 How to generate a strong key in Linux/macOS:
# Run this command in your terminal and copy the output:
# openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_token_here
